PORT=4190
SERVICE_NAME=hydrascope
DB_PATH=./data/hydrascope.db
LOG_DIR=./logs

# HydraDB v0.4.0 OpenCypher Graph Engine (optional: runs zero-config embedded graph if unset)
HYDRADB_GRAPH_URL=http://127.0.0.1:8443
HYDRADB_GRAPH_TOKEN=replace-with-hydradb-auth-token
HYDRADB_GRAPH_ID=hydrascope
HYDRADB_CELL_ID=cell-0
HYDRADB_NAMESPACE=default
HYDRADB_ALLOW_LAN=false
HYDRADB_ALLOW_TAILSCALE=false
# Optional Bolt URI for @hydradb/selfgraph HydraDBStore (defaults to embedded KuzuStore when unset)
HYDRADB_BOLT_URI=
SELFGRAPH_BACKEND=
SELFGRAPH_KUZU_PATH=

# Optional Bearer secret to require Authorization: Bearer <token> on mutating HTTP Studio endpoints
HYDRASCOPE_ADMIN_TOKEN=

# Optional dense 1024d embedding host for Vector Store comparison baseline
OLLAMA_EMBED_HOST=http://127.0.0.1:11434
EMBED_MODEL=snowflake-arctic-embed2:latest

# Optional workspace containment root for stdio MCP directory ingestion (defaults to process.cwd())
HYDRASCOPE_WORKSPACE_ROOT=
