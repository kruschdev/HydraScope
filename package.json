{
  "name": "hydrascope",
  "version": "0.1.1",
  "type": "module",
  "description": "HydraScope: Live Agent Context Layer (Skills, 64 MCP Tools, Resolved Entities & Code AST) Built on Self-Hosted HydraDB",
  "author": "kruschdev <kruschdev@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruschdev/hydrascope.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "client/src",
    "client/public",
    "client/index.html",
    "client/package.json",
    "client/vite.config.js",
    "config.json",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example",
    "INSTALL.md",
    "spec.md",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "bin": {
    "hydrascope": "./bin/hydrascope.js",
    "hydrascope-mcp": "./src/mcp/hydrascope-mcp.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp": "node src/mcp/hydrascope-mcp.js",
    "bench": "node bin/hydrascope.js bench",
    "continual": "node bin/hydrascope.js continual",
    "load": "node bin/hydrascope.js load",
    "selfgraph": "node bin/hydrascope.js selfgraph",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "test": "NODE_ENV=test node --test tests/*.test.js"
  },
  "dependencies": {
    "@hydradb/selfgraph": "https://raw.githubusercontent.com/kruschdev/HydraScope/main/vendor/hydradb-selfgraph-0.2.1.tgz",
    "@krusch/toolkit": "https://github.com/kruschdev/toolkit/archive/f83d665ae8eb5677cd3397af2238ee508815b811.tar.gz",
    "kuzu": "^0.11.3"
  },
  "overrides": {
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.9",
    "tar": "^7.5.21",
    "uuid": "^11.1.1"
  },
  "mcpName": "dev.krusch/hydrascope"
}
