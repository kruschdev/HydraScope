{
  "name": "hydrascope",
  "version": "0.1.0",
  "type": "module",
  "description": "HydraScope: Live Agent Context Layer (Skills, 64 MCP Tools, Resolved Entities & Code AST) Built on Self-Hosted HydraDB",
  "author": "kruschdev <kruschdev@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruschdev/hydrascope.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "hydrascope": "./bin/hydrascope.js",
    "hydrascope-mcp": "./src/mcp/hydrascope-mcp.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp": "node src/mcp/hydrascope-mcp.js",
    "bench": "node bin/hydrascope.js bench",
    "continual": "node bin/hydrascope.js continual",
    "load": "node bin/hydrascope.js load",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "test": "NODE_ENV=test node --test tests/*.test.js"
  },
  "dependencies": {
    "@krusch/toolkit": "https://github.com/kruschdev/toolkit/archive/b8bc7506bc4cf5c9ccb2a7ae76ae171e98ce99ad.tar.gz"
  }
}
